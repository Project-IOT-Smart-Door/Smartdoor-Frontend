<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================== -->
    <!-- WARNA UTAMA: ADMIN (Indigo / Biru-Ungu)    -->
    <!-- ========================================== -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#6366F1"/>
    <!-- Indigo Modern -->
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#8B5CF6"/>
    <!-- Purple Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#8B5CF6"/>

    <!-- ========================================== -->
    <!-- WARNA UTAMA: USER (Teal / Hijau Kebiruan)  -->
    <!-- ========================================== -->
    <SolidColorBrush x:Key="UserPrimaryBrush" Color="#0D9488"/>
    <!-- Teal Gelap -->
    <SolidColorBrush x:Key="UserSecondaryBrush" Color="#14B8A6"/>
    <!-- Teal Terang -->

    <!-- ========================================== -->
    <!-- WARNA STATUS                                -->
    <!-- ========================================== -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>

    <!-- ========================================== -->
    <!-- BACKGROUND & CARD (Dominan Putih Cerah)    -->
    <!-- ========================================== -->
    <SolidColorBrush x:Key="BgBrush" Color="#F8FAFC"/>
    <!-- Putih keabu-abuan -->
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <!-- Putih Bersih -->
    <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF"/>
    <!-- Sidebar Putih -->
    <SolidColorBrush x:Key="HoverBrush" Color="#F1F5F9"/>

    <!-- ========================================== -->
    <!-- TEXT                                        -->
    <!-- ========================================== -->
    <SolidColorBrush x:Key="TextBrush" Color="#0F172A"/>
    <!-- Hitam pekat -->
    <SolidColorBrush x:Key="SubTextBrush" Color="#64748B"/>
    <!-- Abu-abu -->
    <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="LightTextBrush" Color="#FFFFFF"/>

    <!-- ========================================== -->
    <!-- BORDER                                      -->
    <!-- ========================================== -->
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#CBD5E1"/>

</ResourceDictionary>