{
  "ConnectionStrings": {
    // Pilihan 1: SQL Server LocalDB (default, sudah terinstal bersama .NET / SSMS)
    // Server=(localdb)\MSSQLLocalDB
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=SmartDoor;Trusted_Connection=True;TrustServerCertificate=True",

    // Pilihan 2: SQL Server Express (jika Anda menginstal SQLEXPRESS)
    // "Default": "Server=localhost\\SQLEXPRESS;Database=SmartDoor;Trusted_Connection=True;TrustServerCertificate=True",

    // Pilihan 3: SQL Server instans penuh / remote server (SSMS 22)
    // "Default": "Server=NAMA_SERVER\\NAMA_INSTANSI;Database=SmartDoor;User Id=sa;Password=your_password;TrustServerCertificate=True",

    // Pilihan 4: SQL Server dengan Windows Authentication di server lain
    // "Default": "Server=NAMA_SERVER\\NAMA_INSTANSI;Database=SmartDoor;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "AppSettings": {
    "CompanyCode": "KEL4",
    "IdPintu": 1,
    "Actor": "app",
    "SerialPort": "COM3",
    "SerialBaudRate": 9600
  }
}
