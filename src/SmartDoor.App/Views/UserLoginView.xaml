<UserControl x:Class="SmartDoor.App.Views.UserLoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}">
    <Grid>
        <Border Width="450" Padding="40" CornerRadius="16" 
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="4" Opacity="0.08" Color="#0D9488"/>
            </Border.Effect>

            <StackPanel>
                <Button Command="{Binding GoBackCommand}" HorizontalAlignment="Left" 
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,0,15">
                    <TextBlock Text="← Kembali" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold"/>
                </Button>

                <Border Width="80" Height="80" CornerRadius="40" Background="#CCFBF1" HorizontalAlignment="Center">
                    <TextBlock Text="👤" FontSize="40" FontFamily="Segoe UI Emoji" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="LOGIN USER" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource UserPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,15,0,25"/>

                <!-- Username -->
                <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" Margin="0,0,0,15"/>

                <!-- Password -->
                <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,5"/>
                <PasswordBox x:Name="PwdBox" PasswordChanged="PwdBox_PasswordChanged" Style="{StaticResource InputPasswordBox}" Margin="0,0,0,10"/>

                <!-- TAMBAHAN: Tombol Lupa Password -->
                <Button Content="Lupa Password?" Command="{Binding ForgotPasswordCommand}"
                        HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource UserPrimaryBrush}" FontSize="12" Cursor="Hand" Margin="0,0,0,15"/>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,0,0,15" TextWrapping="Wrap"/>

                <!-- Tombol Login -->
                <Button Content="MASUK" Command="{Binding LoginCommand}" 
                        Height="46" FontSize="14" FontWeight="Bold"
                        Background="{DynamicResource UserPrimaryBrush}" Foreground="White"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock Text="────────  atau  ────────" 
                           Foreground="{DynamicResource MutedTextBrush}"
                           HorizontalAlignment="Center" Margin="0,20,0,10"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Belum punya akun? " Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                    <Button Content="Daftar terlebih dahulu" 
                            Command="{Binding GoToRegisterCommand}"
                            Background="Transparent" BorderThickness="0" 
                            Foreground="{DynamicResource UserPrimaryBrush}" 
                            FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>