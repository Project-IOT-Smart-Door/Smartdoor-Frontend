<UserControl x:Class="SmartDoor.App.Views.ContactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}">
    <Grid>
        <Border Width="500" Padding="40" CornerRadius="16" Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="4" Opacity="0.08" Color="#0D9488"/>
            </Border.Effect>

            <StackPanel>
                <Button Command="{Binding GoBackCommand}" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,0,15">
                    <TextBlock Text="← Kembali" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold"/>
                </Button>

                <TextBlock Text="📞" FontSize="50" FontFamily="Segoe UI Emoji" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Hubungi Admin" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Ada kendala dengan kartu atau pintu? Sampaikan ke kami." FontSize="13" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,5,0,25"/>

                <Border Background="{DynamicResource BgBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="📱 WhatsApp: 0812-3456-7890" FontSize="14" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="📧 Email: admin@smartdoor.id" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Pesan Laporan:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,5"/>
                <TextBox Style="{StaticResource InputTextBox}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20" VerticalContentAlignment="Top" Padding="10"/>

                <Button Content="Kirim Pesan Laporan" Command="{Binding KirimLaporanCommand}" Style="{StaticResource PrimaryButton}" Background="{DynamicResource UserPrimaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>