<UserControl x:Class="SmartDoor.App.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}">
    <Grid>
        <Border Width="500" Padding="40" CornerRadius="16" Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <Button Command="{Binding GoBackCommand}" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,0,20">
                    <TextBlock Text="← Kembali ke Dashboard" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold"/>
                </Button>

                <Border Width="90" Height="90" CornerRadius="45" Background="{DynamicResource UserSecondaryBrush}" HorizontalAlignment="Center">
                    <TextBlock Text="👤" FontSize="45" FontFamily="Segoe UI Emoji" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Profil Saya" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,15,0,25"/>

                <TextBlock Text="Nama Lengkap" FontSize="12" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,5"/>
                <Border Background="{DynamicResource BgBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                    <TextBlock Text="{Binding Nama}" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                </Border>

                <TextBlock Text="Username" FontSize="12" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,5"/>
                <Border Background="{DynamicResource BgBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                    <TextBlock Text="{Binding Username}" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>