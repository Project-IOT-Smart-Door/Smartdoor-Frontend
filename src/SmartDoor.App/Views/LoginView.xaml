<UserControl x:Class="SmartDoor.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}">
    <Grid>
        <!-- Latar belakang dekoratif (opsional, memberi sentuhan warna lembut di pojok) -->
        <Ellipse Width="500" Height="500" Fill="#EEF2FF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-200,-200,0,0" Opacity="0.5"/>
        <Ellipse Width="500" Height="500" Fill="#CCFBF1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-200,-200" Opacity="0.5"/>

        <!-- Konten Utama -->
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Cards -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- HEADER: Logo & Judul -->
            <StackPanel Grid.Row="0" Margin="0,0,0,40">
                <Border Width="80" Height="80" CornerRadius="40" Background="White" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.1" Color="#6366F1"/>
                    </Border.Effect>
                    <TextBlock Text="🔐" FontSize="40" FontFamily="Segoe UI Emoji" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Smart Door Access" FontSize="28" FontWeight="Bold" 
                           Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,15,0,5"/>
                <TextBlock Text="Silakan pilih mode akses yang ingin Anda gunakan" 
                           FontSize="14" Foreground="{DynamicResource SubTextBrush}" 
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- CARDS: Admin & User -->
            <StackPanel Grid.Row="1" Orientation="Horizontal">

                <!-- Card ADMIN -->
                <Button Command="{Binding GoToAdminLoginCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0" Margin="0,0,25,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="280" Height="320" Background="{DynamicResource CardBrush}" 
                                    CornerRadius="20" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.15" Color="#4F46E5"/>
                                </Border.Effect>
                                <StackPanel VerticalAlignment="Center">
                                    <Border Width="90" Height="90" CornerRadius="45" Background="#EEF2FF" HorizontalAlignment="Center">
                                        <TextBlock Text="🛡️" FontFamily="Segoe UI Emoji" FontSize="45" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="ADMIN" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,20,0,10"/>
                                    <TextBlock Text="Kelola sistem, pengguna,&#x0a;dan log akses pintu." FontSize="13" Foreground="{DynamicResource SubTextBrush}" TextAlignment="Center" HorizontalAlignment="Center" Margin="20,0"/>

                                    <!-- Teks Tambahan -->
                                    <Border Background="#EEF2FF" CornerRadius="10" Padding="10,4" Margin="0,15,0,0" HorizontalAlignment="Center">
                                        <TextBlock Text="Akses Penuh" FontSize="11" FontWeight="SemiBold" Foreground="#4F46E5"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Card USER -->
                <Button Command="{Binding GoToUserLoginCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="280" Height="320" Background="{DynamicResource CardBrush}" 
                                    CornerRadius="20" BorderBrush="{DynamicResource UserPrimaryBrush}" BorderThickness="2">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.15" Color="#0D9488"/>
                                </Border.Effect>
                                <StackPanel VerticalAlignment="Center">
                                    <Border Width="90" Height="90" CornerRadius="45" Background="#CCFBF1" HorizontalAlignment="Center">
                                        <TextBlock Text="👤" FontFamily="Segoe UI Emoji" FontSize="45" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="USER" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource UserPrimaryBrush}" HorizontalAlignment="Center" Margin="0,20,0,10"/>
                                    <TextBlock Text="Tap kartu RFID untuk&#x0a;masuk atau melihat riwayat." FontSize="13" Foreground="{DynamicResource SubTextBrush}" TextAlignment="Center" HorizontalAlignment="Center" Margin="20,0"/>

                                    <!-- Teks Tambahan -->
                                    <Border Background="#CCFBF1" CornerRadius="10" Padding="10,4" Margin="0,15,0,0" HorizontalAlignment="Center">
                                        <TextBlock Text="Akses Terbatas" FontSize="11" FontWeight="SemiBold" Foreground="#0D9488"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>

            <!-- FOOTER: Hak Cipta -->
            <StackPanel Grid.Row="2" Margin="0,50,0,0" HorizontalAlignment="Center">
                <TextBlock Text="© 2026 Project IOT Smart Door" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Sistem Keamanan Pintu Cerdas Berbasis RFID" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

        </Grid>
    </Grid>
</UserControl>