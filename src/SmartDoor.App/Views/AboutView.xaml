<UserControl x:Class="SmartDoor.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}">
    <Grid Margin="30">
        <Button Command="{Binding GoBackCommand}" HorizontalAlignment="Left" VerticalAlignment="Top" 
                Background="Transparent" BorderThickness="0" Cursor="Hand">
            <TextBlock Text="← Kembali" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold" FontSize="14"/>
        </Button>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">
            <TextBlock Text="🔐" FontSize="80" FontFamily="Segoe UI Emoji" HorizontalAlignment="Center"/>
            <TextBlock Text="Smart Door Access" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,15,0,5"/>
            <TextBlock Text="Versi 1.0.0 (Build 2026)" FontSize="12" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="25" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <TextBlock Text="Aplikasi ini adalah sistem keamanan pintu cerdas berbasis RFID yang terintegrasi dengan Arduino dan Database SQL Server. Dirancang untuk memberikan kenyamanan akses sekaligus keamanan berlapis." 
                           TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextBrush}" LineHeight="24" TextAlignment="Center"/>
            </Border>

            <TextBlock Text="© 2026 Project IOT Smart Door" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,30,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>