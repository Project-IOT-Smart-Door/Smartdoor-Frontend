<UserControl x:Class="SmartDoor.App.Views.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR KIRI (Indigo) ================= -->
        <Border Grid.Column="0" Background="{DynamicResource PrimaryDarkBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Profil Admin -->
                <StackPanel Grid.Row="0" Margin="0,30,0,25">
                    <Border Width="70" Height="70" CornerRadius="35" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="🛡️" FontFamily="Segoe UI Emoji" FontSize="35" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding AdminName}" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,2"/>
                    <TextBlock Text="Administrator" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 2. Menu Navigasi -->
                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource SidebarButton}" Background="{DynamicResource PrimaryBrush}" Foreground="White" Margin="10,0,10,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontFamily="Segoe UI Emoji" Margin="0,0,12,0"/>
                            <TextBlock Text="Dashboard" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- TOMBOL DATA PENGGUNA (Sudah ditambahkan Command) -->
                    <Button Style="{StaticResource SidebarButton}" Foreground="#CBD5E1" Margin="10,0" Command="{Binding GoToUserDataCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" FontFamily="Segoe UI Emoji" Margin="0,0,12,0"/>
                            <TextBlock Text="Data Pengguna"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Height="1" Fill="#64748B" Opacity="0.3" Margin="20,10"/>

                    <!-- Menu Fitur -->
                    <Button Style="{StaticResource SidebarButton}" Foreground="#CBD5E1" Margin="10,0" Command="{Binding GoToDiagramCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📈" FontFamily="Segoe UI Emoji" Margin="0,0,12,0"/>
                            <TextBlock Text="Diagram Akses"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}" Foreground="#CBD5E1" Margin="10,0" Command="{Binding GoToRegisterCardCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🪪" FontFamily="Segoe UI Emoji" Margin="0,0,12,0"/>
                            <TextBlock Text="Daftar Kartu Baru"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}" Foreground="#CBD5E1" Margin="10,0" Command="{Binding GoToBlockCardCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚫" FontFamily="Segoe UI Emoji" Margin="0,0,12,0"/>
                            <TextBlock Text="Blokir Kartu"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}" Foreground="#CBD5E1" Margin="10,0" Command="{Binding GoToAboutCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ️" FontFamily="Segoe UI Emoji" Margin="0,0,12,0"/>
                            <TextBlock Text="Tentang Aplikasi"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 3. Tema & Logout -->
                <StackPanel Grid.Row="2" Margin="0,0,0,20">
                    <TextBlock Text="TEMA TAMPILAN" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="20,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                        <Button Content="☀️" Command="{Binding ThemeLightCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="5" ToolTip="Mode Terang" FontFamily="Segoe UI Emoji" FontSize="16"/>
                        <Button Content="🌙" Command="{Binding ThemeDarkCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="5" ToolTip="Mode Gelap" FontFamily="Segoe UI Emoji" FontSize="16"/>
                        <Button Content="🎨" Command="{Binding ThemeCustomCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="5" ToolTip="Mode Custom" FontFamily="Segoe UI Emoji" FontSize="16"/>
                    </StackPanel>
                    <Button Command="{Binding LogoutCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚪" FontFamily="Segoe UI Emoji" Foreground="#F87171" Margin="0,0,8,0" FontSize="16"/>
                            <TextBlock Text="Keluar Sistem" Foreground="#F87171" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= KONTEN UTAMA ================= -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Dashboard Monitoring" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Pantau aktivitas pintu dan kelola data pengguna." FontSize="13" Foreground="{DynamicResource SubTextBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Content="Logout" Command="{Binding LogoutCommand}" HorizontalAlignment="Right" Background="{DynamicResource DangerBrush}" Foreground="White" Padding="20,8" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- Statistik -->
            <Grid Grid.Row="1" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Total Pengguna" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                            <TextBlock Text="{Binding TotalUsers}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="👥" FontSize="30" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" Opacity="0.5"/>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Total Akses" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                            <TextBlock Text="{Binding TotalAccess}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource UserPrimaryBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="🔄" FontSize="30" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" Opacity="0.5"/>
                    </Grid>
                </Border>
                <Border Grid.Column="4" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Akses Ditolak" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                            <TextBlock Text="{Binding TotalDenied}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="🚫" FontSize="30" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" Opacity="0.5"/>
                    </Grid>
                </Border>
                <Border Grid.Column="6" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Status Pintu" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                            <TextBlock Text="{Binding DoorStatus}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,10,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="🚪" FontSize="30" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" Opacity="0.5"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Tombol Aksi -->
            <Grid Grid.Row="2" Margin="0,0,0,15">
                <TextBlock Text="Log Akses Terakhir" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                <Button Content="🔓 BUKA PINTU MANUAL" Command="{Binding OpenDoorManualCommand}" HorizontalAlignment="Right" Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold" Padding="20,10" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- Tabel DataGrid -->
            <Border Grid.Row="3" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="1">
                <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" RowHeaderWidth="0" RowHeight="40" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderBrush}">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="15,10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Waktu" Binding="{Binding Waktu}" Width="150"/>
                        <DataGridTextColumn Header="UID Kartu" Binding="{Binding UID}" Width="200"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="✅ BERHASIL">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="❌ DITOLAK">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>