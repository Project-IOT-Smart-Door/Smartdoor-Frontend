<UserControl x:Class="SmartDoor.App.Views.UserDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <!-- Sidebar Lebar 250 -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR KIRI (Teal) ================= -->
        <Border Grid.Column="0" Background="{DynamicResource UserPrimaryBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Profil -->
                    <RowDefinition Height="*"/>
                    <!-- Menu Navigasi -->
                    <RowDefinition Height="Auto"/>
                    <!-- Tema & Logout -->
                </Grid.RowDefinitions>

                <!-- 1. Profil User -->
                <StackPanel Grid.Row="0" Margin="0,30,0,25">
                    <Border Width="70" Height="70" CornerRadius="35" Background="{DynamicResource UserSecondaryBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="👤" FontFamily="Segoe UI Emoji" FontSize="35" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding UserName}" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,2"/>
                    <TextBlock Text="Pengguna Aktif" Foreground="#CCFBF1" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 2. Menu Navigasi -->
                <StackPanel Grid.Row="1">
                    <!-- Menu Utama -->
                    <Button Style="{StaticResource SidebarButton}" Background="{DynamicResource UserSecondaryBrush}" Foreground="White" Margin="10,0,10,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏠" FontFamily="Segoe UI Emoji" Margin="0,0,12,0"/>
                            <TextBlock Text="Beranda" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}" Foreground="#CCFBF1" Margin="10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🪪" FontFamily="Segoe UI Emoji" Margin="0,0,12,0"/>
                            <TextBlock Text="Kartu Saya"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}" Foreground="#CCFBF1" Margin="10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontFamily="Segoe UI Emoji" Margin="0,0,12,0"/>
                            <TextBlock Text="Riwayat Saya"/>
                        </StackPanel>
                    </Button>

                    <!-- TOMBOL PROFIL (TAMBAHAN BARU) -->
                    <Button Style="{StaticResource SidebarButton}" Foreground="#CCFBF1" Margin="10,0" Command="{Binding GoToProfileCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontFamily="Segoe UI Emoji" Margin="0,0,12,0"/>
                            <TextBlock Text="Profil Saya"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Height="1" Fill="#CCFBF1" Opacity="0.2" Margin="20,10"/>

                    <!-- Menu Fitur -->
                    <Button Style="{StaticResource SidebarButton}" Foreground="#CCFBF1" Margin="10,0" Command="{Binding GoToDiagramCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📈" FontFamily="Segoe UI Emoji" Margin="0,0,12,0"/>
                            <TextBlock Text="Diagram Akses"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}" Foreground="#CCFBF1" Margin="10,0" Command="{Binding GoToRegisterCardCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🪪" FontFamily="Segoe UI Emoji" Margin="0,0,12,0"/>
                            <TextBlock Text="Daftar Kartu"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}" Foreground="#CCFBF1" Margin="10,0" Command="{Binding GoToContactCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📞" FontFamily="Segoe UI Emoji" Margin="0,0,12,0"/>
                            <TextBlock Text="Hubungi Admin"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}" Foreground="#CCFBF1" Margin="10,0" Command="{Binding GoToAboutCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ️" FontFamily="Segoe UI Emoji" Margin="0,0,12,0"/>
                            <TextBlock Text="Tentang Aplikasi"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 3. Tema & Logout -->
                <StackPanel Grid.Row="2" Margin="0,0,0,20">
                    <TextBlock Text="TEMA TAMPILAN" Foreground="#99F6E4" FontSize="10" FontWeight="Bold" Margin="20,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                        <Button Content="☀️" Command="{Binding ThemeLightCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="5" ToolTip="Mode Terang" FontFamily="Segoe UI Emoji" FontSize="16"/>
                        <Button Content="🌙" Command="{Binding ThemeDarkCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="5" ToolTip="Mode Gelap" FontFamily="Segoe UI Emoji" FontSize="16"/>
                        <Button Content="🎨" Command="{Binding ThemeCustomCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="5" ToolTip="Mode Custom" FontFamily="Segoe UI Emoji" FontSize="16"/>
                    </StackPanel>
                    <Button Command="{Binding LogoutCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚪" FontFamily="Segoe UI Emoji" Foreground="#F87171" Margin="0,0,8,0" FontSize="16"/>
                            <TextBlock Text="Keluar Sistem" Foreground="#F87171" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= KONTEN UTAMA (Tabel & Card) ================= -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding UserName, StringFormat='Halo, {0}! 👋'}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Berikut ringkasan aktivitas kartu Anda hari ini." FontSize="13" Foreground="{DynamicResource SubTextBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Content="Logout" Command="{Binding LogoutCommand}" HorizontalAlignment="Right" Background="{DynamicResource DangerBrush}" Foreground="White" Padding="20,8" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- Kartu Status -->
            <Grid Grid.Row="1" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="16" Padding="30">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0D9488" Offset="0"/>
                            <GradientStop Color="#14B8A6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.2" Color="#0D9488"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🪪" FontFamily="Segoe UI Emoji" FontSize="70" VerticalAlignment="Center" Margin="0,0,25,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="KARTU AKSES ANDA" FontSize="12" FontWeight="Bold" Foreground="#CCFBF1" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding CardUID}" FontSize="32" FontWeight="Bold" Foreground="White" FontFamily="Consolas"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Border Background="#10B981" CornerRadius="4" Padding="8,2" Margin="0,0,15,0">
                                    <TextBlock Text="{Binding CardStatus}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="{Binding RegisterDate, StringFormat='Terdaftar: {0}'}" FontSize="12" Foreground="#CCFBF1" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="20">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🔄" FontSize="30" FontFamily="Segoe UI Emoji" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Total Akses" FontSize="12" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalAksesBulanIni, StringFormat='{}{0} Kali'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource UserPrimaryBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Tabel Riwayat -->
            <Border Grid.Row="2" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Riwayat Akses Terakhir" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,15"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding AccessHistory}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" RowHeaderWidth="0" RowHeight="40" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderBrush}">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="15,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Waktu" Binding="{Binding Waktu}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="✅ Berhasil">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="❌ Ditolak">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>